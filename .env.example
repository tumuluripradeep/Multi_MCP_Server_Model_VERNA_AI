# Copy to .env and fill in real values: cp .env.example .env
# Do not commit .env (contains secrets).

# -----------------------------------------------------------------------------
# Azure OpenAI (required for most MCP servers and the Streamlit UI)
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# -----------------------------------------------------------------------------
# Google Custom Search (web_search_scrape_rag MCP server)
# -----------------------------------------------------------------------------
GOOGLE_SEARCH_ENGINE_ID=your-custom-search-engine-id
GOOGLE_API_KEY=your-google-api-key

# -----------------------------------------------------------------------------
# YouTube (youtube MCP server)
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=your-youtube-data-api-key

# -----------------------------------------------------------------------------
# Atlassian / Confluence & Jira (mcp_atlassian MCP server)
# -----------------------------------------------------------------------------
CONFLUENCE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_PERSONAL_TOKEN=your-confluence-api-token
JIRA_URL=https://your-org.atlassian.net/
JIRA_PERSONAL_TOKEN=your-jira-api-token

# -----------------------------------------------------------------------------
# Slack (slack MCP server and optional slack_listener client)
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_TEAM_ID=T00000000
SLACK_CHANNEL_IDS=C00000000,C00000001

# -----------------------------------------------------------------------------
# Microsoft Teams (optional ms_teams_listner client)
# -----------------------------------------------------------------------------
TEAMS_APP_ID=your-teams-app-id
TEAMS_APP_PASSWORD=your-teams-app-password
TEAMS_PORT=8009

# -----------------------------------------------------------------------------
# Dynamics 365 — Customer Service (service_system MCP server)
# -----------------------------------------------------------------------------
D365_API_BASE_URL=https://your-api.example.com/api/v1/summary
D365_DYNAMICS_API_URL=https://your-org.crm.dynamics.com/api/data/v9.2
D365_TENANT_ID=your-azure-ad-tenant-id
D365_TOKEN_URL=https://login.microsoftonline.com/your-azure-ad-tenant-id/oauth2/v2.0/token
D365_CLIENT_ID=your-app-registration-client-id
D365_CLIENT_SECRET=your-app-registration-client-secret
D365_SCOPE=https://your-org.crm.dynamics.com/.default

# -----------------------------------------------------------------------------
# Dynamics 365 — Sales and Marketing (sales_system MCP server)
# -----------------------------------------------------------------------------
DYNAMICS_SALES_URL_BASE=https://your-org.crm.dynamics.com/api/data/v9.2/leads
DYNAMICS_SALES_CLIENT_ID=your-app-registration-client-id
DYNAMICS_SALES_CLIENT_SECRET=your-app-registration-client-secret
DYNAMICS_SALES_TENANT_ID=your-azure-ad-tenant-id
DYNAMICS_SALES_SCOPE=https://your-org.crm.dynamics.com/.default
DYNAMICS_SALES_TOKEN_URL=https://login.microsoftonline.com/your-azure-ad-tenant-id/oauth2/v2.0/token
CAMPAIGNS_URL_BASE=https://your-org.crm.dynamics.com/api/data/v9.2/campaigns

# -----------------------------------------------------------------------------
# Optional — alternate LLM providers (if not using Azure OpenAI)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=

# -----------------------------------------------------------------------------
# Optional — runtime tuning
# -----------------------------------------------------------------------------
# AGENT_INVOKE_TIMEOUT=180
# PARALLEL_TASK_TIMEOUT=180
# LLM_REQUEST_TIMEOUT=
# DISABLE_STREAMING=false
# STREAM_LLM=true
# KEYWORD_SEARCH_ENDPOINT=http://localhost:8080/api/v1/keyword_search
# VECTOR_DB_ENDPOINT=http://localhost:8080/api/v1/vectors/upsert
